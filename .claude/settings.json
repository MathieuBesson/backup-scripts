{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "deny": [
      "Read(./secrets/var.sh)",
      "Read(./**/.env)",
      "Read(./**/*.passphrase)",
      "Read(./**/*.key)"
    ]
  }
}
